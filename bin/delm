#!/usr/bin/env python3
"""Installed Python CLI; no Tern, model, Node SDK or author checkout required."""
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True  # Managed version trees must remain byte-for-byte clean.
runpy.run_path(str(Path(__file__).resolve().parents[1] / "scripts" / "delm_local.py"), run_name="__main__")
